PORT=4000
HOST=127.0.0.1
# Comma-separated list of allowed browser origins.
CLIENT_ORIGIN=http://localhost:5173
# When true (default), also allow any localhost/127.0.0.1/LAN IP origin on any port.
# Set to false to restrict access to CLIENT_ORIGIN only.
ALLOW_LOCAL_NETWORK=true
LOG_LEVEL=info
# Hours to keep fetched reels, downloaded clips, uploads, exports, and in-progress
# projects before they are auto-removed (keeps disk usage bounded). Projects reset
# this clock on each edit. Set to 24 for a full-day window.
RETENTION_HOURS=6
